# =========================================================
# DB 접속 정보 예시
# 이 파일을 같은 폴더에 db.properties 라는 이름으로 복사한 뒤, A·B 중 하나만 주석(#)을 풀어 쓰세요.
# db.properties에는 비밀번호가 들어가요. 메신저·GitHub에 올리지 말고 USB 등으로 직접 옮기세요.
# =========================================================

# ---------------------------------------------------------
# A. Supabase (PostgreSQL 클라우드) — 어느 PC에서든 같은 DB
#  - 테이블은 Supabase SQL Editor에서 sql/schema-postgres.sql을 실행해 만들어요.
#  - 드라이버: WEB-INF/lib/postgresql-42.x.jar
#  - 주소는 Supabase 대시보드 → Connect → "Session pooler"에 나온 값을 써요 (IPv4, 포트 5432).
#    URI 예: postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
#    → 호스트: aws-1-ap-northeast-2.pooler.supabase.com   사용자: postgres.abcdefgh   DB 이름: postgres
#  - "Direct connection"(db.xxxx.supabase.co) 주소는 IPv6 전용이라 학교·집 와이파이에서 안 될 수 있어요.
# ---------------------------------------------------------
#db.driver=org.postgresql.Driver
#db.url=jdbc:postgresql://<호스트>:5432/postgres?sslmode=require
#db.user=postgres.<프로젝트ID>
#db.password=<Supabase 프로젝트를 만들 때 정한 DB 비밀번호>
#db.pool.maxTotal=5

# ---------------------------------------------------------
# B. 내 PC의 MySQL (sql/schema.sql로 만든 DB)
#  - 드라이버: WEB-INF/lib/mysql-connector-j-*.jar
# ---------------------------------------------------------
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/bookmarket?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
db.user=bookmarket
db.password=bookmarket1234

# ---------------------------------------------------------
# 연결 풀 (적지 않으면 아래 기본값)
#  maxTotal: 동시에 열어 둘 수 있는 연결 수 (Supabase 무료는 5 정도로), maxWaitSeconds: 기다리는 최대 시간
# ---------------------------------------------------------
#db.pool.maxTotal=10
#db.pool.maxIdle=5
#db.pool.maxWaitSeconds=10
