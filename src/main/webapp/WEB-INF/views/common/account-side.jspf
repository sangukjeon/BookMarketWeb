<aside class="side pc-only" aria-label="내 계정 메뉴">
  <div class="card" style="display:flex;gap:12px;align-items:center;padding:14px">
    <span class="avatar" style="width:44px;height:44px;font-size:17px" aria-hidden="true">${fn:escapeXml(fn:substring(me.name, 0, 1))}</span>
    <div style="min-width:0">
      <p class="t-title2" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><c:out value="${me.name}" />님</p>
      <p class="t-help">${me.providerLabel} 계정</p>
    </div>
  </div>
  <div class="side__group">
    <h2>내 계정</h2>
    <nav class="side__nav">
      <a href="${ctx}/orders" aria-current="${nav == 'orders' ? 'page' : 'false'}"><ui:icon name="receipt" />주문 내역</a>
      <a href="${ctx}/wishlist" aria-current="${nav == 'wishlist' ? 'page' : 'false'}"><ui:icon name="heart" />찜한 책</a>
      <a href="${ctx}/coupons" aria-current="${nav == 'coupons' ? 'page' : 'false'}"><ui:icon name="ticket-percent" />쿠폰함</a>
      <a href="${ctx}/notifications" aria-current="${nav == 'notifications' ? 'page' : 'false'}"><ui:icon name="bell" />알림<c:if test="${unreadCount > 0}"><span class="count num">${unreadCount}</span></c:if></a>
      <a href="${ctx}/attendance" aria-current="${nav == 'attendance' ? 'page' : 'false'}"><ui:icon name="calendar-check" />출석 체크</a>
      <a href="${ctx}/taste" aria-current="${nav == 'taste' ? 'page' : 'false'}"><ui:icon name="paw-print" />독서 성향 테스트</a>
      <a href="${ctx}/cart"><ui:icon name="shopping-cart" />장바구니<span class="count">${cartCount}권</span></a>
      <a href="${ctx}/mypage" aria-current="${nav == 'mypage' ? 'page' : 'false'}"><ui:icon name="user-round" />내 정보</a>
      <c:if test="${me.admin}"><a href="${ctx}/admin"><ui:icon name="settings" />관리자</a></c:if>
      <form method="post" action="${ctx}/logout">
        <input type="hidden" name="_csrf" value="${sessionScope.csrf}">
        <button type="submit"><ui:icon name="log-out" />로그아웃</button>
      </form>
    </nav>
  </div>
</aside>
